RESEND_API_KEY=
CONTACT_TO_EMAIL=pgandollas@gmail.com
# Until you verify a domain in Resend, use the default sender below (can only email your own Resend account address).
CONTACT_FROM_EMAIL=Prince John <onboarding@resend.dev>

# Portfolio assistant (chatbot). Get a key at console.anthropic.com and set a monthly spend limit on it.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-5-5, the cheapest).
ASSISTANT_MODEL=

# Hard monthly spend cap for the assistant in USD (default 2). Over budget, visitors get the free built-in FAQ.
# 0 turns the AI off completely. Shared across servers only if Upstash (below) is configured.
MONTHLY_BUDGET_USD=2

# Set to 0 to send EVERY question to the model (for evaluating it). Default: common questions are answered free first.
FAQ_FIRST=

# Optional: durable rate limits shared across serverless instances (Upstash Redis REST).
# Without these, limits are per instance and only slow bursts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile bot check on the chatbot. Set BOTH to enable it.
# The site key is public by design; the secret key must stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Evaluation only: lets `npm run assistant:eval` read token usage. Leave unset in production.
EXPOSE_USAGE=
