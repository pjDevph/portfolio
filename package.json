{
  "name": "prince-john-gandollas-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "assistant:check": "node scripts/check-assistant-model.mjs",
    "assistant:eval": "node evals/assistant/run.mjs",
    "assistant:eval:selftest": "node evals/assistant/selftest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run assistant:eval:selftest && npm run test:faq",
    "check:secrets": "node scripts/check-secrets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run check:secrets && npm run check:docs && npm run build && npm run check:secrets && npm run smoke",
    "test:faq": "tsx evals/assistant/faq-coverage.ts",
    "build:docs": "tsx scripts/build-docs.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "build:resume": "tsx scripts/build-resume.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@vercel/analytics": "^1.3.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "playwright-core": "^1.64.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
